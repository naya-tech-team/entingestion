# The bucket and kms_key_id are named after the account (entingestion-tfstate-<account>-<region>,
# alias/entingestion-tfstate); the Makefile passes them from AWS_ACCOUNT_ID (docs/AWS_ACCESS.md).
key          = "prod/ui/terraform.tfstate"
region       = "us-west-2"
encrypt      = true
use_lockfile = true
