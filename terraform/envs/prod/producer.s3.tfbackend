# The bucket, kms_key_id and region come from the environment: the Makefile passes them from
# AWS_ACCOUNT_ID and STATE_REGION (default AWS_REGION): entingestion-tfstate-<account>-<region>,
# alias/entingestion-tfstate (terraform/bootstrap, docs/AWS_ACCESS.md).
key          = "prod/producer/terraform.tfstate"
encrypt      = true
use_lockfile = true
