# Used once the state moves into S3 (README.md "Move this stack's state into S3"). The bucket,
# kms_key_id and region come from the environment on the command line, never this file:
#   -backend-config=region=$AWS_REGION
#   -backend-config=bucket=entingestion-tfstate-<account>-<region>
#   -backend-config=kms_key_id=arn:aws:kms:<region>:<account>:alias/entingestion-tfstate
key          = "bootstrap/terraform.tfstate"
encrypt      = true
use_lockfile = true
