ry></mxCell><mxCell id="a-22" value="4  POST /uploads {filename, type, size, sha256, external_id}" style="html=1;endArrow=block;endFill=1;strokeColor=#333333;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="95.0" y="304" as="sourcePoint"/><mxPoint x="285.0" y="304" as="targetPoint"/></mxGeometry></mxCell><mxCell id="a-23" value="5  upload PENDING + seq; process tickets_issued, pending +1" style="html=1;endArrow=block;endFill=1;strokeColor=#333333;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="285.0" y="352" as="sourcePoint"/><mxPoint x="665.0" y="352" as="targetPoint"/></mxGeometry></mxCell><mxCell id="a-24" value="6  201 ticket {url signed with size, sha256, upload id}" style="html=1;endArrow=block;endFill=1;strokeColor=#333333;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;verticalAlign=bottom;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="285.0" y="400" as="sourcePoint"/><mxPoint x="95.0" y="400" as="targetPoint"/></mxGeometry></mxCell><mxCell id="a-25" value="7  PUT bytes with exactly the ticket headers" style="html=1;endArrow=block;endFill=1;strokeColor=#333333;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="95.0" y="448" as="sourcePoint"/><mxPoint x="855.0" y="448" as="targetPoint"/></mxGeometry></mxCell><mxCell id="a-26" value="8  ObjectCreated (raw/)" style="html=1;endArrow=block;endFill=1;strokeColor=#333333;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="855.0" y="496" as="sourcePoint"/><mxPoint x="1045.0" y="496" as="targetPoint"/></mxGeometry></mxCell><mxCell id="a-27" value="9  batch (partial failures reported)" style="html=1;endArrow=block;endFill=1;strokeColor=#333333;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1045.0" y="544" as="sourcePoint"/><mxPoint x="1235.0" y="544" as="targetPoint"/></mxGeometry></mxCell><mxCell id="a-28" value="10  claim: PENDING -&gt; REGISTERING" style="html=1;endArrow=block;endFill=1;strokeColor=#333333;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1235.0" y="592" as="sourcePoint"/><mxPoint x="665.0" y="592" as="targetPoint"/></mxGeometry></mxCell><mxCell id="a-29" value="11  verify size, SHA-256 and file type" style="html=1;endArrow=block;endFill=1;strokeColor=#333333;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1235.0" y="640" as="sourcePoint"/><mxPoint x="855.0" y="640" as="targetPoint"/></mxGeometry></mxCell><mxCell id="a-30" value="12  upsert STAGED + tenant (newer ticket wins)" style="html=1;endArrow=block;endFill=1;strokeColor=#333333;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1235.0" y="688" as="sourcePoint"/><mxPoint x="1425.0" y="688" as="targetPoint"/></mxGeometry></mxCell><mxCell id="a-31" value="13  registered_count +1 (membership marker, exact once)" style="html=1;endArrow=block;endFill=1;strokeColor=#333333;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1235.0" y="736" as="sourcePoint"/><mxPoint x="475.0" y="736" as="targetPoint"/></mxGeometry></mxCell><mxCell id="a-32" value="14  REGISTERED / REJECTED / SUPERSEDED; pending -1" style="html=1;endArrow=block;endFill=1;strokeColor=#333333;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1235.0" y="784" as="sourcePoint"/><mxPoint x="665.0" y="784" as="targetPoint"/></mxGeometry></mxCell><mxCell id="a-33" value="15  POST /close {expected_count?} (default: tickets issued)" style="html=1;endArrow=block;endFill=1;strokeColor=#333333;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="95.0" y="832" as="sourcePoint"/><mxPoint x="285.0" y="832" as="targetPoint"/></mxGeometry></mxCell><mxCell id="b-34" value="&lt;b&gt;16  stream INSERT/MODIFY -&amp;gt; ingestion&lt;/b&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontFamily=Helvetica;fontSize=12;fontSize=10;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="1275.0" y="868" width="150" height="34" as="geometry"/></mxCell><mxCell id="t-35" value="Idempotent: duplicate S3 events, retried POSTs (Idempotency-Key) and out-of-order events can't duplicate, double-count or roll an article back; a delete leaves a tombstone. settled = CLOSED, no upload pending, tickets &gt;= expected_count. The hourly janitor expires unused tickets (or re-sends a lost event) and closes idle processes." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#555555;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="30" y="950" width="1400" height="40" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="page-3" name="3. Ingestion trigger and dispatch"><mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1700" pageHeight="1100" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="t-1" value="&lt;b&gt;Ingestion: from the articles stream to one execution per article version&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=20;fontColor=#1a1a1a;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="1200" height="30" as="geometry"/></mxCell><mxCell id="t-2" value="Four entry points feed two queues; the dispatcher turns each message into one Step Functions execution with a deterministic name." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#555555;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="20" y="40" width="1400" height="24" as="geometry"/></mxCell><mxCell id="b-3" value="&lt;b&gt;articles stream&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px' color='#555555'&gt;producer DynamoDB stream&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="240" width="170" height="60" as="geometry"/></mxCell><mxCell id="b-4" value="&lt;b&gt;EventBridge Pipe&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px' color='#555555'&gt;filter: INSERT/MODIFY STAGED, REMOVE&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="1"><mxGeometry x="270" y="240" width="190" height="60" as="geometry"/></mxCell><mxCell id="b-5" value="&lt;b&gt;pipe DLQ&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px' color='#555555'&gt;alarm pipe-dlq-not-empty&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="1"><mxGeometry x="270" y="100" width="190" height="50" as="geometry"/></mxCell><mxCell id="b-6" value="&lt;b&gt;ingest queue&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px' color='#555555'&gt;SQS&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="1"><mxGeometry x="560" y="240" width="170" height="60" as="geometry"/></mxCell><mxCell id="b-7" value="&lt;b&gt;ingest DLQ&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px' color='#555555'&gt;after 50 receives (bad body: at once)&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="1"><mxGeometry x="560" y="100" width="170" height="50" as="geometry"/></mxCell><mxCell id="b-8" value="&lt;b&gt;reconciler&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px' color='#555555'&gt;hourly re-queue&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="1"><mxGeometry x="420" y="460" width="170" height="60" as="geometry"/></mxCell><mxCell id="b-9" value="&lt;b&gt;Control API&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px' color='#555555'&gt;/v1/ingest, /processes/{id}/ingest, /dlq/redrive&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="1"><mxGeometry x="640" y="460" width="200" height="60" as="geometry"/></mxCell><mxCell id="b-10" value="&lt;b&gt;reindex state machine&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px' color='#555555'&gt;/v1/reindex&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#e6d0de;strokeColor=#996185;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="1"><mxGeometry x="900" y="460" width="190" height="60" as="geometry"/></mxCell><mxCell id="b-11" value="&lt;b&gt;backfill queue&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px' color='#555555'&gt;SQS + DLQ, lower priority&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="1"><mxGeometry x="900" y="340" width="190" height="60" as="geometry"/></mxCell><mxCell id="b-12" value="&lt;b&gt;dispatcher&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px' color='#555555'&gt;admission: live / backfill slots&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1150" y="240" width="180" height="60" as="geometry"/></mxCell><mxCell id="b-13" value="&lt;b&gt;ingest state machine&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px' color='#555555'&gt;one execution per version&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#e6d0de;strokeColor=#996185;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1400" y="240" width="200" height="60" as="geometry"/></mxCell><mxCell id="e-14" value="records" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#333333;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="b-3" target="b-4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e-15" value="IngestMessage" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#333333;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="b-4" target="b-6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e-16" value="undeliverable" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#333333;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;dashed=1;" edge="1" parent="1" source="b-4" target="b-5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e-17" value="max receives" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#333333;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;dashed=1;" edge="1" parent="1" source="b-6" target="b-7"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e-18" value="batch" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#333333;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="b-6" target="b-12"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e-19" value="RECONCILER" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#333333;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=0;entryX=0.25;entryY=1;" edge="1" parent="1" source="b-8" target="b-6"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="505" y="400"/><mxPoint x="602" y="400"/></Array></mxGeometry></mxCell><mxCell id="e-20" value="MANUAL" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#333333;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=0;entryX=0.75;entryY=1;" edge="1" parent="1" source="b-9" target="b-6"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="740" y="400"/><mxPoint x="687" y="400"/></Array></mxGeometry></mxCell><mxCell id="e-21" value="BACKFILL" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#333333;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="b-10" target="b-11"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e-22" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#333333;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0.5;entryY=1;" edge="1" parent="1" source="b-11" target="b-12"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1240" y="370"/></Array></mxGeometry></mxCell><mxCell id="e-23" value="StartExecution" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#333333;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="b-12" target="b-13"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="g-24" value="Dispatcher rules" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#666666;dashed=1;verticalAlign=top;align=left;spacingLeft=8;spacingTop=4;fontStyle=1;fontColor=#666666;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1150" y="420" width="480" height="300" as="geometry"/></mxCell><mxCell id="t-25" value="&amp;bull; Parses each record into an &lt;b&gt;IngestMessage&lt;/b&gt;: article_id, process_id, event UPSERT/REMOVE, s3_uri + version, content_sha256, source_updated_at, trigger, force, from_stage, target_table.&lt;br&gt;&amp;bull; Execution name = &lt;code&gt;{article_id}-{sha256(sha|process|updated_at|pipeline_version)[:32]}&lt;/code&gt;: the same stream record delivered 3x starts one execution (DUP); ExecutionAlreadyExists is acked.&lt;br&gt;&amp;bull; MANUAL, RECONCILER and BACKFILL runs add &lt;code&gt;-r&amp;lt;run id&amp;gt;&lt;/code&gt;, so replays always start.&lt;br&gt;&amp;bull; Admission control: a run starts only with a free slot (#SLOTS, live / backfill lanes, leased). Without one the message waits (up to 40 s), then goes back to the queue, so queue age shows the backlog.&lt;br&gt;&amp;bull; Throttled starts are reported as batch item failures and retried by SQS." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#333333;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1160" y="445" width="460" height="270" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="page-4" name="4. Ingest state machine"><mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1700" pageHeight="1100" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="t-1" value="&lt;b&gt;Ingest state machine (asl/ingest.asl.json.tftpl)&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=20;fontColor=#1a1a1a;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="1200" height="30" as="geometry"/></mxCell><mxCell id="t-2" value="Every task: Retry by error class, Catch IngestStale -&gt; Stale (quiet end), Catch States.ALL -&gt; MarkFailed. Each step reads the previous step's staged output. Whole run: 3 h timeout." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#555555;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="20" y="40" width="1400" height="24" as="geometry"/></mxCell><mxCell id="b-3" value="&lt;b&gt;Claim&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px' color='#555555'&gt;lease + RUN#: NEW, CHANGED, UNCHANGED, METADATA, DELETE&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="1"><mxGeometry x="520" y="90" width="160" height="50" as="geometry"/></mxCell><mxCell id="b-4" value="&lt;b&gt;Route&lt;/b&gt;" style="rhombus;whiteSpace=wrap;html=1;fillColor=#e6d0de;strokeColor=#996185;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="1"><mxGeometry x="535" y="165" width="130" height="70" as="geometry"/></mxCell><mxCell id="b-5" value="&lt;b&gt;Fetch&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px' color='#555555'&gt;raw object, verify SHA-256&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="1"><mxGeometry x="520" y="270" width="160" height="50" as="geometry"/></mxCell><mxCell id="b-6" value="&lt;b&gt;AfterFetch&lt;/b&gt;" style="rhombus;whiteSpace=wrap;html=1;fillColor=#e6d0de;strokeColor=#996185;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="1"><mxGeometry x="535" y="335" width="130" height="60" as="geometry"/></mxCell><mxCell id="b-7" value="&lt;b&gt;Extract&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px' color='#555555'&gt;HTML, PDF, DOCX, TXT&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="1"><mxGeometry x="520" y="420" width="160" height="50" as="geometry"/></mxCell><mxCell id="b-8" value="&lt;b&gt;AfterExtract&lt;/b&gt;" style="rhombus;whiteSpace=wrap;html=1;fillColor=#e6d0de;strokeColor=#996185;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="1"><mxGeometry x="535" y="485" width="130" height="60" as="geometry"/></mxCell><mxCell id="b-9" value="&lt;b&gt;Normalize&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px' color='#555555'&gt;clean blocks&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="1"><mxGeometry x="520" y="570" width="160" height="50" as="geometry"/></mxCell><mxCell id="b-10" value="&lt;b&gt;Chunk&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px' color='#555555'&gt;512 tokens, 64 overlap&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="1"><mxGeometry x="520" y="645" width="160" height="50" as="geometry"/></mxCell><mxCell id="b-11" value="&lt;b&gt;Embed&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px' color='#555555'&gt;cache, then Bedrock&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="1"><mxGeometry x="520" y="720" width="160" height="50" as="geometry"/></mxCell><mxCell id="b-12" value="&lt;b&gt;Validate&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px' color='#555555'&gt;gate -&amp;gt; _manifest.&amp;lt;table&amp;gt;.json (STAGED)&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="1"><mxGeometry x="520" y="795" width="160" height="50" as="geometry"/></mxCell><mxCell id="b-13" value="&lt;b&gt;Index&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px' color='#555555'&gt;every write table (in VPC)&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="1"><mxGeometry x="520" y="870" width="160" height="50" as="geometry"/></mxCell><mxCell id="b-14" value="&lt;b&gt;AfterIndex&lt;/b&gt;" style="rhombus;whiteSpace=wrap;html=1;fillColor=#e6d0de;strokeColor=#996185;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="1"><mxGeometry x="535" y="935" width="130" height="60" as="geometry"/></mxCell><mxCell id="b-15" value="&lt;b&gt;Finalize&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px' color='#555555'&gt;INDEXED, roll-up, event&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="1"><mxGeometry x="520" y="1020" width="160" height="50" as="geometry"/></mxCell><mxCell id="b-16" value="&lt;b&gt;Done&lt;/b&gt;" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="1"><mxGeometry x="820" y="1025" width="110" height="40" as="geometry"/></mxCell><mxCell id="e-17" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#333333;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="b-3" target="b-4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e-18" value="RUN, start FETCH" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#333333;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="b-4" target="b-5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e-19" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#333333;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="b-5" target="b-6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e-20" value="direct" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#333333;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="b-6" target="b-7"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e-21" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#333333;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="b-7" target="b-8"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e-22" value="text found" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#333333;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="b-8" target="b-9"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e-23" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#333333;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="b-9" target="b-10"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e-24" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#333333;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="b-10" target="b-11"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e-25" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#333333;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="b-11" target="b-12"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e-26" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#333333;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="b-12" target="b-13"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e-27" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#333333;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="b-13" target="b-14"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e-28" value="UPSERT" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#333333;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="b-14" target="b-15"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e-29" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#333333;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="b-15" target="b-16"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e-30" value="DELETE / METADATA" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#333333;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;" edge="1" parent="1" source="b-14" target="b-16"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="860" y="965"/></Array></mxGeometry></mxCell><mxCell id="e-31" value="DELETE / METADATA" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#333333;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;exitX=0;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="b-4" target="b-13"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="420" y="200"/><mxPoint x="420" y="895"/></Array></mxGeometry></mxCell><mxCell id="e-32" value="UNCHANGED (skipped)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#333333;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0.75;entryY=0;" edge="1" parent="1" source="b-4" target="b-16"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="900" y="200"/></Array></mxGeometry></mxCell><mxCell id="t-33" value="Resume/replay: Route jumps to start_at (EXTRACT ... FINALIZE) after the last succeeded step whose staged ETag still matches. METADATA: Index updates the chunks' metadata in place. A run that meets a pending delete hands the article over." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=10;fontColor=#555555;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="60" y="160" width="330" height="100" as="geometry"/></mxCell><mxCell id="b-34" value="&lt;b&gt;OcrStart&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px' color='#555555'&gt;Textract async job&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="1"><mxGeometry x="200" y="420" width="150" height="50" as="geometry"/></mxCell><mxCell id="b-35" value="&lt;b&gt;OcrWait&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px' color='#555555'&gt;ocr_poll_seconds&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#e6d0de;strokeColor=#996185;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="1"><mxGeometry x="200" y="500" width="150" height="40" as="geometry"/></mxCell><mxCell id="b-36" value="&lt;b&gt;OcrPoll&lt;/b&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="1"><mxGeometry x="200" y="565" width="150" height="45" as="geometry"/></mxCell><mxCell id="b-37" value="&lt;b&gt;OcrDone&lt;/b&gt;" style="rhombus;whiteSpace=wrap;html=1;fillColor=#e6d0de;strokeColor=#996185;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="1"><mxGeometry x="210" y="630" width="130" height="60" as="geometry"/></mxCell><mxCell id="t-38" value="max OCR_MAX_POLLS, then E_TIMEOUT" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=10;fontColor=#555555;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="60" y="700" width="140" height="40" as="geometry"/></mxCell><mxCell id="b-39" value="&lt;b&gt;OcrCollect&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px' color='#555555'&gt;pages -&amp;gt; blocks&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="1"><mxGeometry x="200" y="720" width="150" height="50" as="geometry"/></mxCell><mxCell id="e-40" value="PDF over 50 MB" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#333333;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;exitX=0;exitY=0.5;entryX=0.5;entryY=0;" edge="1" parent="1" source="b-6" target="b-34"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="275" y="365"/></Array></mxGeometry></mxCell><mxCell id="e-41" value="scanned (no text layer)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#333333;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;exitX=0;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="1" source="b-8" target="b-34"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="420" y="515"/><mxPoint x="420" y="445"/></Array></mxGeometry></mxCell><mxCell id="e-42" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#333333;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="b-34" target="b-35"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e-43" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#333333;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="b-35" target="b-36"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e-44" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#333333;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="b-36" target="b-37"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e-45" value="IN_PROGRESS" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#333333;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;exitX=0;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="b-37" target="b-35"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="170" y="660"/><mxPoint x="170" y="520"/></Array></mxGeometry></mxCell><mxCell id="e-46" value="done" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#333333;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="b-37" target="b-39"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e-47" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#333333;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="b-39" target="b-9"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="440" y="745"/><mxPoint x="440" y="595"/></Array></mxGeometry></mxCell><mxCell id="g-48" value="Any task" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#b85450;dashed=1;verticalAlign=top;align=left;spacingLeft=8;spacingTop=4;fontStyle=1;fontColor=#b85450;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1000" y="270" width="560" height="500" as="geometry"/></mxCell><mxCell id="b-49" value="&lt;b&gt;MarkFailed&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px' color='#555555'&gt;classify, record, metric&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1040" y="430" width="160" height="50" as="geometry"/></mxCell><mxCell id="b-50" value="&lt;b&gt;Outcome&lt;/b&gt;" style="rhombus;whiteSpace=wrap;html=1;fillColor=#e6d0de;strokeColor=#996185;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1055" y="510" width="130" height="70" as="geometry"/></mxCell><mxCell id="b-51" value="&lt;b&gt;Stale (succeed)&lt;/b&gt;" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1300" y="320" width="140" height="40" as="geometry"/></mxCell><mxCell id="b-52" value="&lt;b&gt;Failed&lt;/b&gt;" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1300" y="610" width="110" height="40" as="geometry"/></mxCell><mxCell id="t-53" value="&lt;b&gt;Retry&lt;/b&gt; (per task)&lt;br&gt;IngestThrottled / Lambda.TooManyRequests: 12 attempts, up to 120 s apart; own budget (throttle_count 20), not retry_count&lt;br&gt;IngestTransient / Lambda 5xx: 2 s x2, 3 attempts&lt;br&gt;&lt;br&gt;&lt;b&gt;Catch&lt;/b&gt;&lt;br&gt;IngestStale (lost the lease) -&amp;gt; Stale&lt;br&gt;States.ALL -&amp;gt; MarkFailed" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=10;fontColor=#333333;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1030" y="300" width="260" height="130" as="geometry"/></mxCell><mxCell id="e-54" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#333333;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="b-49" target="b-50"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e-55" value="SKIPPED" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#333333;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=1;entryY=0.5;" edge="1" parent="1" source="b-50" target="b-16"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1120" y="1045"/></Array></mxGeometry></mxCell><mxCell id="e-56" value="STALE" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#333333;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0.5;entryY=1;" edge="1" parent="1" source="b-50" target="b-51"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1370" y="545"/></Array></mxGeometry></mxCell><mxCell id="e-57" value="FAILED_RETRYABLE / PERMANENT" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#333333;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0;entryY=0.5;" edge="1" parent="1" source="b-50" target="b-52"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1120" y="630"/></Array></mxGeometry></mxCell><mxCell id="t-58" value="FAILED_RETRYABLE: the reconciler retries with backoff (5x), then FAILED_PERMANENT.&lt;br&gt;FAILED_PERMANENT: metric by error_code + hourly digest; fix and redrive (POST /v1/dlq/redrive).&lt;br&gt;A run that already finished (INDEXED / DELETED) ends Done: a late failure can't undo it." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=10;fontColor=#555555;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1220" y="670" width="330" height="80" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="page-5" name="5. Status model"><mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1700" pageHeight="1100" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="t-1" value="&lt;b&gt;Status model: ingestion_status table and LATEST lifecycle&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=20;fontColor=#1a1a1a;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="1200" height="30" as="geometry"/></mxCell><mxCell id="t-2" value="Status lives only in ingestion_status. One table, pk = article_id or PROCESS#&lt;id&gt;, four sparse GSIs." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#555555;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="20" y="40" width="1400" height="24" as="geometry"/></mxCell><mxCell id="b-3" value="&lt;b&gt;LATEST&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px' color='#555555'&gt;pk article_id, sk LATEST&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="1"><mxGeometry x="30" y="90" width="260" height="58" as="geometry"/></mxCell><mxCell id="b-4" value="&lt;b&gt;status, stage, run_id, doc_version, content_sha256, meta_sha256, source_updated_at (ordering + tombstone), lease_owner, lease_expires_at, delete_requested_at, tv_&amp;lt;table&amp;gt;, staging_prefix, chunk_count, error_code&lt;/b&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontFamily=Helvetica;fontSize=12;fontStyle=0;fontSize=10;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="290" y="90" width="560" height="58" as="geometry"/></mxCell><mxCell id="b-5" value="&lt;b&gt;RUN#&amp;lt;run_id&amp;gt;&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px' color='#555555'&gt;~1 year (TTL)&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="1"><mxGeometry x="30" y="154" width="260" height="58" as="geometry"/></mxCell><mxCell id="b-6" value="&lt;b&gt;trigger, claim decision (action, version, start, tables: a retried Claim repeats it), slot, outcome (… SUPERSEDED, METADATA_UPDATED, DELETE_DEFERRED, PREEMPTED)&lt;/b&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontFamily=Helvetica;fontSize=12;fontStyle=0;fontSize=10;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="290" y="154" width="560" height="58" as="geometry"/></mxCell><mxCell id="b-7" value="&lt;b&gt;RUN#&amp;lt;run_id&amp;gt;#STEP#nn_NAME&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px' color='#555555'&gt;~90 days (TTL)&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="1"><mxGeometry x="30" y="218" width="260" height="58" as="geometry"/></mxCell><mxCell id="b-8" value="&lt;b&gt;step_status, attempt, attempts (last 5), duration_ms, input_uri, output_uri, output_etag, metrics, error_class, error_code, error_msg&lt;/b&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontFamily=Helvetica;fontSize=12;fontStyle=0;fontSize=10;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="290" y="218" width="560" height="58" as="geometry"/></mxCell><mxCell id="b-9" value="&lt;b&gt;PROCESS#&amp;lt;pid&amp;gt; / SUMMARY&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px' color='#555555'&gt;process roll-up&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="1"><mxGeometry x="30" y="282" width="260" height="58" as="geometry"/></mxCell><mxCell id="b-10" value="&lt;b&gt;indexed, skipped, failed counters; status OPEN -&amp;gt; COMPLETE / COMPLETE_WITH_ERRORS&lt;/b&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontFamily=Helvetica;fontSize=12;fontStyle=0;fontSize=10;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="290" y="282" width="560" height="58" as="geometry"/></mxCell><mxCell id="b-11" value="&lt;b&gt;PROCESS#&amp;lt;pid&amp;gt; / ARTICLE#&amp;lt;aid&amp;gt;&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px' color='#555555'&gt;membership&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="1"><mxGeometry x="30" y="346" width="260" height="58" as="geometry"/></mxCell><mxCell id="b-12" value="&lt;b&gt;first terminal outcome per (process, article): exact counts; replay FAILED -&amp;gt; INDEXED moves the counters&lt;/b&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontFamily=Helvetica;fontSize=12;fontStyle=0;fontSize=10;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="290" y="346" width="560" height="58" as="geometry"/></mxCell><mxCell id="b-13" value="&lt;b&gt;&amp;lt;article&amp;gt; / SHADOW#&amp;lt;table&amp;gt;&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px' color='#555555'&gt;shadow runs&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="1"><mxGeometry x="30" y="410" width="260" height="58" as="geometry"/></mxCell><mxCell id="b-14" value="&lt;b&gt;reindex, rebuild, drift repair of one table: own status and lease; never LATEST or the roll-up&lt;/b&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontFamily=Helvetica;fontSize=12;fontStyle=0;fontSize=10;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="290" y="410" width="560" height="58" as="geometry"/></mxCell><mxCell id="b-15" value="&lt;b&gt;#CONFIG / ...&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px' color='#555555'&gt;configuration&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="1"><mxGeometry x="30" y="474" width="260" height="58" as="geometry"/></mxCell><mxCell id="b-16" value="&lt;b&gt;VECTOR_TABLES (live, writes, epoch); sweep cursors; failure-digest cursor&lt;/b&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontFamily=Helvetica;fontSize=12;fontStyle=0;fontSize=10;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="290" y="474" width="560" height="58" as="geometry"/></mxCell><mxCell id="b-17" value="&lt;b&gt;#SLOTS / &amp;lt;lane&amp;gt;#&amp;lt;i&amp;gt;&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px' color='#555555'&gt;admission control&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="1"><mxGeometry x="30" y="538" width="260" height="58" as="geometry"/></mxCell><mxCell id="b-18" value="&lt;b&gt;live and backfill run slots: holder run, lease expiry&lt;/b&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontFamily=Helvetica;fontSize=12;fontStyle=0;fontSize=10;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="290" y="538" width="560" height="58" as="geometry"/></mxCell><mxCell id="t-19" value="&lt;b&gt;GSIs&lt;/b&gt;&lt;br&gt;gsi1-status: status + updated_at (redrive by status, reconciler, backlog metrics)&lt;br&gt;gsi2-process: process_id (process re-run, summary)&lt;br&gt;gsi3-lease: lease expiry (reconciler: expired leases)&lt;br&gt;gsi4-stepfail: failed steps by error_code; DELETE#PENDING (deletes waiting for a run to hand over)" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#333333;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="30" y="610" width="820" height="90" as="geometry"/></mxCell><mxCell id="t-20" value="&lt;b&gt;Records per run&lt;/b&gt;: first run 10 (LATEST created + RUN# + 8 steps); later clean run 9; unchanged 1 (RUN# SKIPPED_UNCHANGED); metadata change 2; delete 2." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#333333;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="30" y="710" width="820" height="50" as="geometry"/></mxCell><mxCell id="b-21" value="&lt;b&gt;CLAIMED&lt;/b&gt;" style="rounded=1;arcSize=40;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="1"><mxGeometry x="920" y="100" width="150" height="40" as="geometry"/></mxCell><mxCell id="b-22" value="&lt;b&gt;FETCHING&lt;/b&gt;" style="rounded=1;arcSize=40;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="1"><mxGeometry x="920" y="162" width="150" height="40" as="geometry"/></mxCell><mxCell id="b-23" value="&lt;b&gt;EXTRACTING&lt;/b&gt;" style="rounded=1;arcSize=40;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="1"><mxGeometry x="920" y="224" width="150" height="40" as="geometry"/></mxCell><mxCell id="b-24" value="&lt;b&gt;NORMALIZING&lt;/b&gt;" style="rounded=1;arcSize=40;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="1"><mxGeometry x="920" y="286" width="150" height="40" as="geometry"/></mxCell><mxCell id="b-25" value="&lt;b&gt;CHUNKING&lt;/b&gt;" style="rounded=1;arcSize=40;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="1"><mxGeometry x="920" y="348" width="150" height="40" as="geometry"/></mxCell><mxCell id="b-26" value="&lt;b&gt;EMBEDDING&lt;/b&gt;" style="rounded=1;arcSize=40;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="1"><mxGeometry x="920" y="410" width="150" height="40" as="geometry"/></mxCell><mxCell id="b-27" value="&lt;b&gt;VALIDATING&lt;/b&gt;" style="rounded=1;arcSize=40;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="1"><mxGeometry x="920" y="472" width="150" height="40" as="geometry"/></mxCell><mxCell id="b-28" value="&lt;b&gt;STAGED&lt;/b&gt;" style="rounded=1;arcSize=40;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="1"><mxGeometry x="920" y="534" width="150" height="40" as="geometry"/></mxCell><mxCell id="b-29" value="&lt;b&gt;INDEXING&lt;/b&gt;" style="rounded=1;arcSize=40;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="1"><mxGeometry x="920" y="596" width="150" height="40" as="geometry"/></mxCell><mxCell id="b-30" value="&lt;b&gt;INDEXED&lt;/b&gt;" style="rounded=1;arcSize=40;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="1"><mxGeometry x="920" y="658" width="150" height="40" as="geometry"/></mxCell><mxCell id="e-31" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#333333;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="b-21" target="b-22"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e-32" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#333333;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="b-22" target="b-23"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e-33" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#333333;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="b-23" target="b-24"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e-34" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#333333;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="b-24" target="b-25"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e-35" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#333333;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="b-25" target="b-26"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e-36" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#333333;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="b-26" target="b-27"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e-37" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#333333;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="b-27" target="b-28"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e-38" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#333333;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="b-28" target="b-29"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e-39" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#333333;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="b-29" target="b-30"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="b-40" value="&lt;b&gt;SKIPPED_UNCHANGED (run)&lt;/b&gt;" style="rounded=1;arcSize=40;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1250" y="100" width="190" height="40" as="geometry"/></mxCell><mxCell id="b-41" value="&lt;b&gt;SKIPPED&lt;/b&gt;" style="rounded=1;arcSize=40;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1250" y="224" width="190" height="40" as="geometry"/></mxCell><mxCell id="b-42" value="&lt;b&gt;FAILED_RETRYABLE&lt;/b&gt;" style="rounded=1;arcSize=40;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1250" y="410" width="190" height="40" as="geometry"/></mxCell><mxCell id="b-43" value="&lt;b&gt;FAILED_PERMANENT&lt;/b&gt;" style="rounded=1;arcSize=40;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1250" y="534" width="190" height="40" as="geometry"/></mxCell><mxCell id="b-44" value="&lt;b&gt;DELETED&lt;/b&gt;" style="rounded=1;arcSize=40;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1250" y="658" width="190" height="40" as="geometry"/></mxCell><mxCell id="e-45" value="unchanged / older update" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#333333;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="b-21" target="b-40"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e-46" value="no text" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#333333;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="b-23" target="b-41"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e-47" value="transient error" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#333333;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;dashed=1;" edge="1" parent="1" source="b-26" target="b-42"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e-48" value="after 5 retries" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#333333;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="b-42" target="b-43"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e-49" value="permanent error" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#333333;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;dashed=1;exitX=1;exitY=0.5;entryX=0;entryY=0.25;" edge="1" parent="1" source="b-27" target="b-43"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e-50" value="delete run" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#333333;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;dashed=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="b-29" target="b-44"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e-51" value="reconciler re-run" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#333333;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;dashed=1;exitX=1;exitY=0.5;entryX=0.5;entryY=0;" edge="1" parent="1" source="b-42" target="b-21"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1480" y="430"/><mxPoint x="1480" y="70"/><mxPoint x="995" y="70"/></Array></mxGeometry></mxCell><mxCell id="e-52" value="redrive after fix" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#333333;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;dashed=1;exitX=1;exitY=0.5;entryX=0.25;entryY=0;" edge="1" parent="1" source="b-43" target="b-21"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1510" y="554"/><mxPoint x="1510" y="55"/><mxPoint x="957" y="55"/></Array></mxGeometry></mxCell><mxCell id="t-53" value="LATEST.status while each step runs; Validate sets STAGED, Finalize INDEXED. Unchanged content records a SKIPPED_UNCHANGED run; an older update than LATEST's (or not newer than a delete) a SUPERSEDED one. Delete runs go Claim -&gt; Index -&gt; DELETED; a delete during a run sets a marker and the run hands over. Errors can come from any step; stale runs (lost lease) end quietly." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=10;fontColor=#555555;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="920" y="718" width="560" height="70" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="page-6" name="6. Staging and vector store"><mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1700" pageHeight="1100" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="t-1" value="&lt;b&gt;Staging layout and the vector store&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=20;fontColor=#1a1a1a;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="1200" height="30" as="geometry"/></mxCell><mxCell id="t-2" value="Every step stages its output, so any step can re-run alone and pgvector can be rebuilt without extracting or embedding again." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#555555;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="20" y="40" width="1400" height="24" as="geometry"/></mxCell><mxCell id="g-3" value="s3://ingest-staging-&amp;lt;env&amp;gt;-&amp;lt;account&amp;gt;/" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#82b366;dashed=1;verticalAlign=top;align=left;spacingLeft=8;spacingTop=4;fontStyle=1;fontColor=#82b366;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="1"><mxGeometry x="30" y="90" width="560" height="520" as="geometry"/></mxCell><mxCell id="t-4" value="&amp;lt;article_id&amp;gt;/v&amp;lt;doc_version&amp;gt;/   (Fetch reads the producer's raw object; no copy)" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#333333;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="50" y="125" width="520" height="30" as="geometry"/></mxCell><mxCell id="t-5" value="&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;#9492; extracted/content.json  (Extract / OcrCollect)" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#333333;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="50" y="169" width="520" height="30" as="geometry"/></mxCell><mxCell id="t-6" value="&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;#9492; normalized/document.json  (Normalize)" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#333333;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="50" y="213" width="520" height="30" as="geometry"/></mxCell><mxCell id="t-7" value="&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;#9492; chunks/chunks.jsonl  (Chunk)" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#333333;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="50" y="257" width="520" height="30" as="geometry"/></mxCell><mxCell id="t-8" value="&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;#9492; embeddings/&amp;lt;table&amp;gt;.parquet  (Embed; one per vector table)" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#333333;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="50" y="301" width="520" height="30" as="geometry"/></mxCell><mxCell id="t-9" value="&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;#9492; _manifest.&amp;lt;table&amp;gt;.json  (Validate: counts, checksums, model)" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#333333;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="50" y="345" width="520" height="30" as="geometry"/></mxCell><mxCell id="t-10" value="&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;#9492; _tmp/&amp;lt;run_id&amp;gt;/...  (write, then copy; expires)" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#333333;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="50" y="389" width="520" height="30" as="geometry"/></mxCell><mxCell id="t-11" value="_reindex/&amp;lt;execution&amp;gt;.json  (reindex plan; 7 days)" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#333333;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="50" y="433" width="520" height="30" as="geometry"/></mxCell><mxCell id="t-12" value="_eval/golden/&amp;lt;version&amp;gt;.jsonl, _eval/&amp;lt;table&amp;gt;/&amp;lt;ts&amp;gt;.json  (evaluation)" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#333333;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="50" y="477" width="520" height="30" as="geometry"/></mxCell><mxCell id="t-13" value="Write-once per version: write to _tmp, CopyObject to the final key, record the ETag on the step item. A new version retires the older ones (noncurrent, then expired); a delete purges the article's prefix and cache entries." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=10;fontColor=#555555;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="40" y="560" width="540" height="50" as="geometry"/></mxCell><mxCell id="g-14" value="PostgreSQL + pgvector (database ingest)" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#36393d;dashed=1;verticalAlign=top;align=left;spacingLeft=8;spacingTop=4;fontStyle=1;fontColor=#36393d;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="1"><mxGeometry x="640" y="90" width="980" height="520" as="geometry"/></mxCell><mxCell id="b-15" value="&lt;b&gt;chunks_primary&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px' color='#555555'&gt;halfvec(1024), HNSW cosine, weighted tsvector (headings A, text B), tenant_id + RLS&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#cce5ff;strokeColor=#36393d;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="1"><mxGeometry x="670" y="140" width="260" height="90" as="geometry"/></mxCell><mxCell id="b-16" value="&lt;b&gt;chunks_compact&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px' color='#555555'&gt;halfvec(512): created from its profile (model change)&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#cce5ff;strokeColor=#36393d;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="1"><mxGeometry x="670" y="260" width="260" height="90" as="geometry"/></mxCell><mxCell id="b-17" value="&lt;b&gt;chunks_active (view)&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px' color='#555555'&gt;SELECT ... WHERE is_active over the live table&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1000" y="190" width="220" height="70" as="geometry"/></mxCell><mxCell id="b-18" value="&lt;b&gt;ingest_reader&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px' color='#555555'&gt;search (one tenant), eval (query Lambda)&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1300" y="190" width="150" height="60" as="geometry"/></mxCell><mxCell id="b-19" value="&lt;b&gt;article_tombstones&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px' color='#555555'&gt;deleted versions can't be written back&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#cce5ff;strokeColor=#36393d;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1000" y="290" width="220" height="50" as="geometry"/></mxCell><mxCell id="e-20" value="live" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#333333;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;exitX=0;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="1" source="b-17" target="b-15"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e-21" value="switch / roll back" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#333333;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;dashed=1;exitX=0;exitY=0.75;entryX=1;entryY=0.5;" edge="1" parent="1" source="b-17" target="b-16"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e-22" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#333333;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="b-18" target="b-17"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="t-23" value="&lt;b&gt;Index swap (one transaction, per article, per write table)&lt;/b&gt;&lt;br&gt;1. pg_advisory_xact_lock(article_id); refuse an older version or a tombstoned one&lt;br&gt;2. batched INSERT ... ON CONFLICT (chunk_id): version N+1, inactive; drop leftovers of N+1&lt;br&gt;3. verify row count = manifest chunk_count&lt;br&gt;4. UPDATE is_active = (doc_version = N+1)&lt;br&gt;5. DELETE older versions&lt;br&gt;6. COMMIT: readers see N until here, then only N+1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#333333;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="670" y="380" width="540" height="150" as="geometry"/></mxCell><mxCell id="t-24" value="&lt;b&gt;Users&lt;/b&gt; (IAM auth, no stored passwords)&lt;br&gt;ingest_writer: Index&lt;br&gt;ingest_reader: query / eval / search (RLS)&lt;br&gt;ingest_ops: tables function (status, switch)&lt;br&gt;ingest_views: owns chunks_active&lt;br&gt;ingest_admin: master (Secrets Manager), migrate only" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#333333;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1240" y="380" width="360" height="130" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="page-7" name="7. Model change and rebuild"><mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1700" pageHeight="1100" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="t-1" value="&lt;b&gt;Model change (UC9) and rebuild (UC10): reindex, evaluate, switch, roll back&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=20;fontColor=#1a1a1a;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="1200" height="30" as="geometry"/></mxCell><mxCell id="t-2" value="A new table per model/dimension. Live runs write every table in the registry's write set, so the new table never misses an edit; chunks_active switches, so going live and rolling back are instant." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#555555;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="20" y="40" width="1400" height="24" as="geometry"/></mxCell><mxCell id="b-3" value="&lt;b&gt;Operator&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px' color='#555555'&gt;Bruno / awscurl&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="1"><mxGeometry x="30" y="120" width="140" height="60" as="geometry"/></mxCell><mxCell id="b-4" value="&lt;b&gt;POST /v1/reindex&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px' color='#555555'&gt;adds the table to the write set, then starts&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="1"><mxGeometry x="220" y="120" width="170" height="60" as="geometry"/></mxCell><mxCell id="g-5" value="reindex state machine" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#996185;dashed=1;verticalAlign=top;align=left;spacingLeft=8;spacingTop=4;fontStyle=1;fontColor=#996185;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="1"><mxGeometry x="440" y="90" width="620" height="140" as="geometry"/></mxCell><mxCell id="b-6" value="&lt;b&gt;Plan&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px' color='#555555'&gt;reindex_plan: query status, write S3 plan&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="1"><mxGeometry x="460" y="130" width="130" height="60" as="geometry"/></mxCell><mxCell id="b-7" value="&lt;b&gt;AnyArticles&lt;/b&gt;" style="rhombus;whiteSpace=wrap;html=1;fillColor=#e6d0de;strokeColor=#996185;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="1"><mxGeometry x="610" y="125" width="120" height="70" as="geometry"/></mxCell><mxCell id="b-8" value="&lt;b&gt;Enqueue (Distributed Map)&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px' color='#555555'&gt;ItemReader S3, ItemBatcher, EXPRESS children&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#e6d0de;strokeColor=#996185;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="1"><mxGeometry x="760" y="125" width="180" height="70" as="geometry"/></mxCell><mxCell id="b-9" value="&lt;b&gt;Done&lt;/b&gt;" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="1"><mxGeometry x="965" y="140" width="80" height="40" as="geometry"/></mxCell><mxCell id="e-10" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#333333;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="b-3" target="b-4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e-11" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#333333;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="b-4" target="b-6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e-12" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#333333;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="b-6" target="b-7"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e-13" value="yes" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#333333;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="b-7" target="b-8"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e-14" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#333333;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="b-8" target="b-9"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="b-15" value="&lt;b&gt;reindex_enqueue&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px' color='#555555'&gt;messages with target_table&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="1"><mxGeometry x="760" y="290" width="180" height="60" as="geometry"/></mxCell><mxCell id="b-16" value="&lt;b&gt;backfill queue&lt;/b&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1000" y="290" width="160" height="60" as="geometry"/></mxCell><mxCell id="b-17" value="&lt;b&gt;dispatcher&lt;/b&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1220" y="290" width="150" height="60" as="geometry"/></mxCell><mxCell id="e-18" value="batches" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#333333;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="b-8" target="b-15"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e-19" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#333333;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="b-15" target="b-16"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e-20" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#333333;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="b-16" target="b-17"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="g-21" value="ingest state machine, starting mid-way" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#996185;dashed=1;verticalAlign=top;align=left;spacingLeft=8;spacingTop=4;fontStyle=1;fontColor=#996185;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="1"><mxGeometry x="440" y="400" width="930" height="150" as="geometry"/></mxCell><mxCell id="b-22" value="&lt;b&gt;Embed&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px' color='#555555'&gt;target model; cache&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="1"><mxGeometry x="470" y="450" width="140" height="60" as="geometry"/></mxCell><mxCell id="b-23" value="&lt;b&gt;Validate&lt;/b&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="1"><mxGeometry x="650" y="450" width="140" height="60" as="geometry"/></mxCell><mxCell id="b-24" value="&lt;b&gt;Index&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px' color='#555555'&gt;into target_table (shadow run)&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="1"><mxGeometry x="830" y="450" width="140" height="60" as="geometry"/></mxCell><mxCell id="b-25" value="&lt;b&gt;Finalize&lt;/b&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1010" y="450" width="140" height="60" as="geometry"/></mxCell><mxCell id="e-26" value="from_stage EMBED" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#333333;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="b-17" target="b-22"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1295" y="380"/><mxPoint x="540" y="380"/></Array></mxGeometry></mxCell><mxCell id="e-27" value="from_stage INDEX (rebuild, no Bedrock)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#333333;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;dashed=1;exitX=0.67;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="b-17" target="b-24"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1320" y="420"/><mxPoint x="900" y="420"/></Array></mxGeometry></mxCell><mxCell id="e-28" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#333333;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="b-22" target="b-23"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e-29" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#333333;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="b-23" target="b-24"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e-30" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#333333;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="b-24" target="b-25"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="b-31" value="&lt;b&gt;Evaluate&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px' color='#555555'&gt;scripts/evaluate.py --table ... --baseline&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#fad9d5;strokeColor=#ae4132;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="1"><mxGeometry x="470" y="640" width="170" height="70" as="geometry"/></mxCell><mxCell id="b-32" value="&lt;b&gt;POST /v1/tables/active&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px' color='#555555'&gt;gated: written, covered, evaluated; tables function&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="1"><mxGeometry x="720" y="640" width="190" height="70" as="geometry"/></mxCell><mxCell id="b-33" value="&lt;b&gt;Roll back&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px' color='#555555'&gt;same call, previous table&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="1"><mxGeometry x="990" y="640" width="170" height="70" as="geometry"/></mxCell><mxCell id="b-34" value="&lt;b&gt;Retire old table&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px' color='#555555'&gt;DELETE /v1/tables/writes/{table}&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1220" y="640" width="170" height="70" as="geometry"/></mxCell><mxCell id="e-35" value="report &lt; 7 days" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#333333;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="b-31" target="b-32"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e-36" value="if needed" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#333333;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;dashed=1;" edge="1" parent="1" source="b-32" target="b-33"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e-37" value="when settled" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#333333;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;dashed=1;" edge="1" parent="1" source="b-33" target="b-34"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="t-38" value="Switch gate: the table is in the write set, every indexed article's version is in it (tv_&amp;lt;table&amp;gt;), and its newest evaluation on the live table's golden set is no more than 0.02 recall@10 below the live table's; force overrides. Golden sets are versioned (chunk-level labels, no-answer questions); metrics chunk recall@5/10, nDCG@10, MRR with 95% CIs." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#555555;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="470" y="730" width="920" height="60" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="page-8" name="8. Operations"><mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1700" pageHeight="1100" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="t-1" value="&lt;b&gt;Operations: reconciler, alerts, dashboard and the control API&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=20;fontColor=#1a1a1a;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="1200" height="30" as="geometry"/></mxCell><mxCell id="t-2" value="The reconciler only enqueues work or moves items it re-checks in a conditional write; every step is idempotent." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#555555;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="20" y="40" width="1400" height="24" as="geometry"/></mxCell><mxCell id="b-3" value="&lt;b&gt;EventBridge Scheduler&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px' color='#555555'&gt;rate(1 hour); rate(7 days) {drift: true}&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#fad9d5;strokeColor=#ae4132;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="1"><mxGeometry x="30" y="120" width="180" height="60" as="geometry"/></mxCell><mxCell id="b-4" value="&lt;b&gt;reconciler&lt;/b&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="1"><mxGeometry x="270" y="120" width="150" height="60" as="geometry"/></mxCell><mxCell id="e-5" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#333333;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="b-3" target="b-4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="b-6" value="&lt;b&gt;1  Pending deletes whose run never handed over -&amp;gt; REMOVE; expired leases -&amp;gt; re-queue (resume)&lt;/b&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontFamily=Helvetica;fontSize=12;align=left;spacingLeft=8;fontStyle=0;fontSize=10;" vertex="1" parent="1"><mxGeometry x="470" y="90" width="620" height="45" as="geometry"/></mxCell><mxCell id="b-7" value="&lt;b&gt;2  FAILED_RETRYABLE past next_retry_at -&amp;gt; re-queue; after 5 -&amp;gt; FAILED_PERMANENT (digest)&lt;/b&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontFamily=Helvetica;fontSize=12;align=left;spacingLeft=8;fontStyle=0;fontSize=10;" vertex="1" parent="1"><mxGeometry x="470" y="145" width="620" height="45" as="geometry"/></mxCell><mxCell id="b-8" value="&lt;b&gt;3  STAGED for over 30 min -&amp;gt; re-queue from INDEX&lt;/b&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontFamily=Helvetica;fontSize=12;align=left;spacingLeft=8;fontStyle=0;fontSize=10;" vertex="1" parent="1"><mxGeometry x="470" y="200" width="620" height="45" as="geometry"/></mxCell><mxCell id="b-9" value="&lt;b&gt;4  Producer articles updated today/yesterday (gsi_updated_shard) with no matching LATEST -&amp;gt; enqueue (UC7)&lt;/b&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontFamily=Helvetica;fontSize=12;align=left;spacingLeft=8;fontStyle=0;fontSize=10;" vertex="1" parent="1"><mxGeometry x="470" y="255" width="620" height="45" as="geometry"/></mxCell><mxCell id="b-10" value="&lt;b&gt;5  Open process summaries -&amp;gt; completion check (UC11); backlog counts and ages -&amp;gt; metrics; hourly failure digest&lt;/b&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontFamily=Helvetica;fontSize=12;align=left;spacingLeft=8;fontStyle=0;fontSize=10;" vertex="1" parent="1"><mxGeometry x="470" y="310" width="620" height="45" as="geometry"/></mxCell><mxCell id="b-11" value="&lt;b&gt;6  Weekly: every write table vs LATEST (version, count, both ways) -&amp;gt; shadow repairs on the backfill queue; orphans and vanished producer rows -&amp;gt; REMOVE&lt;/b&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontFamily=Helvetica;fontSize=12;align=left;spacingLeft=8;fontStyle=0;fontSize=10;" vertex="1" parent="1"><mxGeometry x="470" y="365" width="620" height="45" as="geometry"/></mxCell><mxCell id="b-12" value="&lt;b&gt;ingest queue&lt;/b&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1150" y="150" width="150" height="60" as="geometry"/></mxCell><mxCell id="e-13" value="re-queue" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#333333;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0.5;entryY=1;" edge="1" parent="1" source="b-4" target="b-12"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="345" y="440"/><mxPoint x="1225" y="440"/></Array></mxGeometry></mxCell><mxCell id="b-14" value="&lt;b&gt;MarkFailed&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px' color='#555555'&gt;metric ArticlesFailedPermanent&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="1"><mxGeometry x="30" y="520" width="150" height="60" as="geometry"/></mxCell><mxCell id="b-15" value="&lt;b&gt;CloudWatch alarms&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px' color='#555555'&gt;DLQ arrivals, backlog age, failure ratio, freshness p95, step p95, DB&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#fad9d5;strokeColor=#ae4132;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="1"><mxGeometry x="30" y="620" width="150" height="60" as="geometry"/></mxCell><mxCell id="b-16" value="&lt;b&gt;alerts topic&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px' color='#555555'&gt;SNS (KMS); email parked&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#fad9d5;strokeColor=#ae4132;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="1"><mxGeometry x="270" y="570" width="150" height="60" as="geometry"/></mxCell><mxCell id="e-17" value="metric" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#333333;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;dashed=1;" edge="1" parent="1" source="b-14" target="b-15"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e-18" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#333333;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="b-15" target="b-16"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e-19" value="hourly digest" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#333333;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;dashed=1;exitX=0.2;exitY=1;entryX=0.2;entryY=0;" edge="1" parent="1" source="b-4" target="b-16"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="b-20" value="&lt;b&gt;Dashboard ingestion-&amp;lt;env&amp;gt;&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px' color='#555555'&gt;flow, backlog, steps, Bedrock, quality, DB, API&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#fad9d5;strokeColor=#ae4132;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="1"><mxGeometry x="30" y="730" width="200" height="60" as="geometry"/></mxCell><mxCell id="g-21" value="Control API (IAM; reader = GET, operator = all, search)" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#d79b00;dashed=1;verticalAlign=top;align=left;spacingLeft=8;spacingTop=4;fontStyle=1;fontColor=#d79b00;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="1"><mxGeometry x="470" y="500" width="900" height="400" as="geometry"/></mxCell><mxCell id="b-22" value="&lt;b&gt;GET /v1/articles/{id}/status&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px' color='#555555'&gt;LATEST, last 5 runs, steps, execution link&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontFamily=Helvetica;fontSize=12;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="490" y="540" width="420" height="52" as="geometry"/></mxCell><mxCell id="b-23" value="&lt;b&gt;GET /v1/processes/{id}/summary&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px' color='#555555'&gt;counts, producer counts, failures by error_code&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontFamily=Helvetica;fontSize=12;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="490" y="602" width="420" height="52" as="geometry"/></mxCell><mxCell id="b-24" value="&lt;b&gt;GET /v1/tables&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px' color='#555555'&gt;live table, write set, rows per table&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontFamily=Helvetica;fontSize=12;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="490" y="664" width="420" height="52" as="geometry"/></mxCell><mxCell id="b-25" value="&lt;b&gt;POST /v1/ingest&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px' color='#555555'&gt;re-run articles (force, from_stage)&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontFamily=Helvetica;fontSize=12;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="490" y="726" width="420" height="52" as="geometry"/></mxCell><mxCell id="b-26" value="&lt;b&gt;POST /v1/processes/{id}/ingest&lt;/b&gt;&lt;br&gt;&lt;font style='