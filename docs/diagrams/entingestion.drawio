geometry"/></mxCell><mxCell id="b-31" value="&lt;b&gt;POST /v1/search&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px' color='#555555'&gt;hybrid search for one tenant (search policy)&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontFamily=Helvetica;fontSize=12;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="930" y="788" width="420" height="52" as="geometry"/></mxCell><mxCell id="t-32" value="Operator POSTs accept dry_run. Bruno: bruno/ (folders 02, 03 and 05)." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=10;fontColor=#555555;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="490" y="860" width="600" height="24" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="page-9" name="9. Network and security"><mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1700" pageHeight="1100" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="t-1" value="&lt;b&gt;Network and security&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=20;fontColor=#1a1a1a;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="1200" height="30" as="geometry"/></mxCell><mxCell id="t-2" value="Private VPC with no internet gateway or NAT; IAM everywhere; KMS on every store." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#555555;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="20" y="40" width="1400" height="24" as="geometry"/></mxCell><mxCell id="g-3" value="VPC 10.40.0.0/16 (3 AZs, private subnets only, flow logs)" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#36393d;dashed=1;verticalAlign=top;align=left;spacingLeft=8;spacingTop=4;fontStyle=1;fontColor=#36393d;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="1"><mxGeometry x="30" y="90" width="1000" height="560" as="geometry"/></mxCell><mxCell id="g-4" value="private subnet (AZ a)" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#6c8ebf;dashed=1;verticalAlign=top;align=left;spacingLeft=8;spacingTop=4;fontStyle=1;fontColor=#6c8ebf;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="1"><mxGeometry x="60" y="140" width="290" height="300" as="geometry"/></mxCell><mxCell id="g-5" value="private subnet (AZ b)" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#6c8ebf;dashed=1;verticalAlign=top;align=left;spacingLeft=8;spacingTop=4;fontStyle=1;fontColor=#6c8ebf;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="1"><mxGeometry x="380" y="140" width="290" height="300" as="geometry"/></mxCell><mxCell id="g-6" value="private subnet (AZ c)" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#6c8ebf;dashed=1;verticalAlign=top;align=left;spacingLeft=8;spacingTop=4;fontStyle=1;fontColor=#6c8ebf;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="1"><mxGeometry x="700" y="140" width="290" height="300" as="geometry"/></mxCell><mxCell id="b-7" value="&lt;b&gt;index&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px' color='#555555'&gt;SG db_client&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="1"><mxGeometry x="90" y="190" width="110" height="50" as="geometry"/></mxCell><mxCell id="b-8" value="&lt;b&gt;query&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px' color='#555555'&gt;SG db_client&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="1"><mxGeometry x="90" y="260" width="110" height="50" as="geometry"/></mxCell><mxCell id="b-9" value="&lt;b&gt;migrate / tables&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px' color='#555555'&gt;SG migrate&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="1"><mxGeometry x="410" y="190" width="130" height="50" as="geometry"/></mxCell><mxCell id="b-10" value="&lt;b&gt;PostgreSQL&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px' color='#555555'&gt;dev: RDS db.t4g.micro; prod: Aurora Serverless v2 + RDS Proxy (TLS, IAM auth required)&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#cce5ff;strokeColor=#36393d;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="1"><mxGeometry x="410" y="300" width="230" height="90" as="geometry"/></mxCell><mxCell id="b-11" value="&lt;b&gt;Secrets Manager endpoint&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px' color='#555555'&gt;interface (migrate only)&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="1"><mxGeometry x="730" y="190" width="170" height="50" as="geometry"/></mxCell><mxCell id="e-12" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#333333;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;entryX=0;entryY=0.3;" edge="1" parent="1" source="b-7" target="b-10"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="250" y="215"/><mxPoint x="250" y="327"/></Array></mxGeometry></mxCell><mxCell id="t-13" value="5432, IAM token" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#333333;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="300" y="300" width="120" height="20" as="geometry"/></mxCell><mxCell id="e-14" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#333333;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;entryX=0;entryY=0.6;" edge="1" parent="1" source="b-8" target="b-10"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="230" y="285"/><mxPoint x="230" y="354"/></Array></mxGeometry></mxCell><mxCell id="e-15" value="5432 (master via secret)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#333333;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="b-9" target="b-10"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="t-16" value="Functions in the VPC use every private subnet; the AZ placement here is illustrative." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=10;fontColor=#555555;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="60" y="450" width="900" height="24" as="geometry"/></mxCell><mxCell id="b-17" value="&lt;b&gt;Gateway endpoints&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px' color='#555555'&gt;S3 and DynamoDB (free), policies limited to this account - in-VPC functions reach staging and status without NAT&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="1"><mxGeometry x="60" y="480" width="940" height="50" as="geometry"/></mxCell><mxCell id="t-18" value="Security groups: db_client and migrate may reach the database SG on 5432 only. Default SG locked. Other functions run outside the VPC and call AWS APIs over TLS." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#333333;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="60" y="560" width="940" height="50" as="geometry"/></mxCell><mxCell id="g-19" value="Identity and encryption" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#ae4132;dashed=1;verticalAlign=top;align=left;spacingLeft=8;spacingTop=4;fontStyle=1;fontColor=#ae4132;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1070" y="90" width="560" height="650" as="geometry"/></mxCell><mxCell id="b-20" value="&lt;b&gt;IAM&lt;/b&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#fad9d5;strokeColor=#ae4132;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1090" y="130" width="110" height="66" as="geometry"/></mxCell><mxCell id="b-21" value="&lt;b&gt;one role per function, least privilege, each within the env's workload boundary. People: aws login + MFA; Terraform as entingestion-&amp;lt;env&amp;gt;-deploy (deploy boundary: no keys, no unbounded roles, no other env) - no access keys&lt;/b&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontFamily=Helvetica;fontSize=12;align=left;spacingLeft=8;fontStyle=0;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1205" y="130" width="405" height="66" as="geometry"/></mxCell><mxCell id="b-22" value="&lt;b&gt;APIs&lt;/b&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#fad9d5;strokeColor=#ae4132;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1090" y="212" width="110" height="66" as="geometry"/></mxCell><mxCell id="b-23" value="&lt;b&gt;AWS_IAM auth + WAF; producer: per-source writers / readers, tenant set server-side; control API reader / operator / search&lt;/b&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontFamily=Helvetica;fontSize=12;align=left;spacingLeft=8;fontStyle=0;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1205" y="212" width="405" height="66" as="geometry"/></mxCell><mxCell id="b-24" value="&lt;b&gt;Database&lt;/b&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#fad9d5;strokeColor=#ae4132;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1090" y="294" width="110" height="66" as="geometry"/></mxCell><mxCell id="b-25" value="&lt;b&gt;IAM DB auth: ingest_writer, ingest_reader (row-level security per tenant), ingest_ops; rds.force_ssl&lt;/b&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontFamily=Helvetica;fontSize=12;align=left;spacingLeft=8;fontStyle=0;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1205" y="294" width="405" height="66" as="geometry"/></mxCell><mxCell id="b-26" value="&lt;b&gt;KMS&lt;/b&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#fad9d5;strokeColor=#ae4132;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1090" y="376" width="110" height="66" as="geometry"/></mxCell><mxCell id="b-27" value="&lt;b&gt;producer CMK - ingestion Decrypt via S3 / DynamoDB only; ingestion CMK (staging, status, cache, logs, DB, SNS); state key (Terraform state)&lt;/b&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontFamily=Helvetica;fontSize=12;align=left;spacingLeft=8;fontStyle=0;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1205" y="376" width="405" height="66" as="geometry"/></mxCell><mxCell id="b-28" value="&lt;b&gt;Data&lt;/b&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#fad9d5;strokeColor=#ae4132;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1090" y="458" width="110" height="66" as="geometry"/></mxCell><mxCell id="b-29" value="&lt;b&gt;S3 versioned, TLS-only, public access blocked; DynamoDB PITR; deletion protection + prevent_destroy in prod&lt;/b&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontFamily=Helvetica;fontSize=12;align=left;spacingLeft=8;fontStyle=0;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1205" y="458" width="405" height="66" as="geometry"/></mxCell><mxCell id="b-30" value="&lt;b&gt;Logs&lt;/b&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#fad9d5;strokeColor=#ae4132;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1090" y="540" width="110" height="66" as="geometry"/></mxCell><mxCell id="b-31" value="&lt;b&gt;JSON logs with article_id, run_id, process_id, step; X-Ray on every function; no document text logged&lt;/b&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontFamily=Helvetica;fontSize=12;align=left;spacingLeft=8;fontStyle=0;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1205" y="540" width="405" height="66" as="geometry"/></mxCell><mxCell id="b-32" value="&lt;b&gt;Audit&lt;/b&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#fad9d5;strokeColor=#ae4132;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1090" y="622" width="110" height="66" as="geometry"/></mxCell><mxCell id="b-33" value="&lt;b&gt;CloudTrail: multi-region trail, log-file validation, own KMS key; data events on the state bucket&lt;/b&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontFamily=Helvetica;fontSize=12;align=left;spacingLeft=8;fontStyle=0;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1205" y="622" width="405" height="66" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="page-10" name="10. Delivery and teardown"><mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1700" pageHeight="1100" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="t-1" value="&lt;b&gt;Delivery: build, plan, apply, verify - and teardown of disposable environments&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=20;fontColor=#1a1a1a;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="1200" height="30" as="geometry"/></mxCell><mxCell id="t-2" value="Code exists once per stack; environments differ only in tfvars (common.tfvars + &amp;lt;stack&amp;gt;.tfvars) and backend. make always pairs them." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#555555;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="20" y="40" width="1400" height="24" as="geometry"/></mxCell><mxCell id="b-3" value="&lt;b&gt;make build&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px' color='#555555'&gt;zips from uv.lock + entcommon, hash-checked, reproducible&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="1"><mxGeometry x="30" y="110" width="220" height="70" as="geometry"/></mxCell><mxCell id="b-4" value="&lt;b&gt;make plan ENV STACK&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px' color='#555555'&gt;as entingestion-&amp;lt;env&amp;gt;-deploy; common + stack tfvars; saved plan&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#fad9d5;strokeColor=#ae4132;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="1"><mxGeometry x="300" y="110" width="220" height="70" as="geometry"/></mxCell><mxCell id="e-5" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#333333;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="b-3" target="b-4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="b-6" value="&lt;b&gt;review plan&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px' color='#555555'&gt;no destroy of data stores&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="1"><mxGeometry x="570" y="110" width="220" height="70" as="geometry"/></mxCell><mxCell id="e-7" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#333333;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="b-4" target="b-6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="b-8" value="&lt;b&gt;make apply&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px' color='#555555'&gt;the saved plan; publishes versions, moves the live alias&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#fad9d5;strokeColor=#ae4132;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="1"><mxGeometry x="840" y="110" width="220" height="70" as="geometry"/></mxCell><mxCell id="e-9" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#333333;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="b-6" target="b-8"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="b-10" value="&lt;b&gt;make migrate&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px' color='#555555'&gt;schema, profile tables, chunks_active (expand / contract)&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1110" y="110" width="220" height="70" as="geometry"/></mxCell><mxCell id="e-11" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#333333;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="b-8" target="b-10"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="b-12" value="&lt;b&gt;smoke / rollback&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px' color='#555555'&gt;acceptance or Bruno; make rollback FN VERSION&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1380" y="110" width="220" height="70" as="geometry"/></mxCell><mxCell id="e-13" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#333333;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="b-10" target="b-12"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="g-14" value="Checks, run locally (CI is disabled)" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#666666;dashed=1;verticalAlign=top;align=left;spacingLeft=8;spacingTop=4;fontStyle=1;fontColor=#666666;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="1"><mxGeometry x="30" y="230" width="760" height="170" as="geometry"/></mxCell><mxCell id="t-15" value="Python (common, producer, ingestion, ui/bff): ruff, mypy --strict, pytest (DynamoDB-strict moto), pgvector integration, license gate&lt;br&gt;Web (services/ui/web): typecheck, vitest, build, npm license gate&lt;br&gt;Terraform: make check - fmt, validate, terraform test (modules + stacks), teardown script tests, pinned tflint + checkov&lt;br&gt;Build: make build (deterministic zips); Renovate proposes upgrades" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#333333;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="50" y="265" width="720" height="120" as="geometry"/></mxCell><mxCell id="g-16" value="Repository layout" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#666666;dashed=1;verticalAlign=top;align=left;spacingLeft=8;spacingTop=4;fontStyle=1;fontColor=#666666;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="1"><mxGeometry x="830" y="230" width="790" height="170" as="geometry"/></mxCell><mxCell id="t-17" value="services/&amp;lt;service&amp;gt;/ - code, tests, build scripts; services/common - shared entcommon&lt;br&gt;terraform/modules/&amp;lt;name&amp;gt;/ - generic modules (tests, examples)&lt;br&gt;terraform/stacks/&amp;lt;stack&amp;gt;/ - producer, ingestion, ui&lt;br&gt;terraform/envs/&amp;lt;env&amp;gt;/common.tfvars + &amp;lt;stack&amp;gt;.tfvars + .s3.tfbackend&lt;br&gt;docs/, bruno/, tools/" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#333333;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="850" y="265" width="760" height="120" as="geometry"/></mxCell><mxCell id="g-18" value="make destroy / destroy-all (terraform/scripts/teardown.py) - never prod" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#b85450;dashed=1;verticalAlign=top;align=left;spacingLeft=8;spacingTop=4;fontStyle=1;fontColor=#b85450;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="1"><mxGeometry x="30" y="440" width="1590" height="230" as="geometry"/></mxCell><mxCell id="b-19" value="&lt;b&gt;Preflight&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px' color='#555555'&gt;refuse prod; stop on deletion protection or force_destroy off&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="1"><mxGeometry x="50" y="500" width="220" height="80" as="geometry"/></mxCell><mxCell id="b-20" value="&lt;b&gt;Confirm&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px' color='#555555'&gt;type the env name (no terminal = no)&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="1"><mxGeometry x="312" y="500" width="220" height="80" as="geometry"/></mxCell><mxCell id="e-21" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#333333;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="b-19" target="b-20"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="b-22" value="&lt;b&gt;Record pending&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px' color='#555555'&gt;.terraform/&amp;lt;env&amp;gt;/teardown-pending.json&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="1"><mxGeometry x="574" y="500" width="220" height="80" as="geometry"/></mxCell><mxCell id="e-23" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#333333;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="b-20" target="b-22"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="b-24" value="&lt;b&gt;Aurora first&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px' color='#555555'&gt;delete instances, cluster; wait (optional snapshot)&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="1"><mxGeometry x="836" y="500" width="220" height="80" as="geometry"/></mxCell><mxCell id="e-25" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#333333;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="b-22" target="b-24"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="b-26" value="&lt;b&gt;terraform destroy&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px' color='#555555'&gt;after state rm of protected resources&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1098" y="500" width="220" height="80" as="geometry"/></mxCell><mxCell id="e-27" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#333333;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="b-24" target="b-26"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="b-28" value="&lt;b&gt;Tables last&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px' color='#555555'&gt;delete DynamoDB tables; wait&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1360" y="500" width="220" height="80" as="geometry"/></mxCell><mxCell id="e-29" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#333333;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="b-26" target="b-28"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="t-30" value="destroy-all order: ui, ingestion, then producer. A failed run resumes when repeated. Left by design: KMS keys pending deletion (30 days), empty state files, the bootstrap state bucket." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#555555;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="50" y="610" width="1500" height="40" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>