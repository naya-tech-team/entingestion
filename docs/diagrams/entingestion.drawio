tyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#333333;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;dashed=1;exitX=1;exitY=0.9;entryX=0;entryY=0.5;" edge="1" parent="1" source="b-30" target="b-35"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1375" y="434"/><mxPoint x="1375" y="510"/></Array></mxGeometry></mxCell><mxCell id="e-57" value="12" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#333333;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;exitX=0;exitY=0.5;" edge="1" parent="1" source="b-29" target="b-37"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="950" y="290"/></Array></mxGeometry></mxCell><mxCell id="e-58" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#333333;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="b-37" target="b-38"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e-59" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#333333;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="b-4" target="b-39"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e-60" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#333333;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="b-39" target="b-40"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e-61" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#333333;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="b-41" target="b-28"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e-62" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#333333;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="b-42" target="b-43"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e-63" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#333333;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="b-43" target="b-44"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e-64" value="alarms" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#333333;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="b-45" target="b-44"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="t-65" value="&lt;b&gt;Main flow&lt;/b&gt;&lt;br&gt;1 create process, get an upload ticket (Producer API)&lt;br&gt;2 PUT the file to S3 with the presigned URL&lt;br&gt;3 ObjectCreated to the registrar queue&lt;br&gt;4 registrar receives the batch&lt;br&gt;5 verified: articles row STAGED&lt;br&gt;6 stream record to the Pipe (filters)&lt;br&gt;7 IngestMessage on the ingest queue&lt;br&gt;8 dispatcher receives it&lt;br&gt;9 one execution per article version&lt;br&gt;10 steps run, staging each output, status in ingestion_status&lt;br&gt;11 Embed calls Bedrock (cache first)&lt;br&gt;12 Index swaps the version into every write table (in the VPC)&lt;br&gt;&lt;br&gt;Search: POST /v1/search embeds the query and fuses vector + keyword matches for one tenant.&lt;br&gt;Access: each source's writers / readers and tenant (producer source_access).&lt;br&gt;Re-runs, redrive, reindex and reconciler re-queues: pages 3, 7 and 8." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#333333;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="230" y="740" width="540" height="300" as="geometry"/></mxCell><mxCell id="g-66" value="Legend" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#999999;dashed=1;verticalAlign=top;align=left;spacingLeft=8;spacingTop=4;fontStyle=1;fontColor=#999999;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="1"><mxGeometry x="20" y="760" width="190" height="282" as="geometry"/></mxCell><mxCell id="b-67" value="&lt;b&gt;API Gateway&lt;/b&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontFamily=Helvetica;fontSize=12;fontSize=10;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="30" y="786" width="170" height="22" as="geometry"/></mxCell><mxCell id="b-68" value="&lt;b&gt;Lambda&lt;/b&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontFamily=Helvetica;fontSize=12;fontSize=10;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="30" y="814" width="170" height="22" as="geometry"/></mxCell><mxCell id="b-69" value="&lt;b&gt;SQS / Pipe&lt;/b&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontFamily=Helvetica;fontSize=12;fontSize=10;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="30" y="842" width="170" height="22" as="geometry"/></mxCell><mxCell id="b-70" value="&lt;b&gt;S3&lt;/b&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontFamily=Helvetica;fontSize=12;fontSize=10;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="30" y="870" width="170" height="22" as="geometry"/></mxCell><mxCell id="b-71" value="&lt;b&gt;DynamoDB&lt;/b&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontFamily=Helvetica;fontSize=12;fontSize=10;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="30" y="898" width="170" height="22" as="geometry"/></mxCell><mxCell id="b-72" value="&lt;b&gt;PostgreSQL&lt;/b&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#cce5ff;strokeColor=#36393d;fontFamily=Helvetica;fontSize=12;fontSize=10;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="30" y="926" width="170" height="22" as="geometry"/></mxCell><mxCell id="b-73" value="&lt;b&gt;AI service&lt;/b&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontFamily=Helvetica;fontSize=12;fontSize=10;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="30" y="954" width="170" height="22" as="geometry"/></mxCell><mxCell id="b-74" value="&lt;b&gt;Step Functions&lt;/b&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#e6d0de;strokeColor=#996185;fontFamily=Helvetica;fontSize=12;fontSize=10;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="30" y="982" width="170" height="22" as="geometry"/></mxCell><mxCell id="b-75" value="&lt;b&gt;Operations&lt;/b&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#fad9d5;strokeColor=#ae4132;fontFamily=Helvetica;fontSize=12;fontSize=10;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="30" y="1010" width="170" height="22" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="page-2" name="2. Upload and registration"><mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1700" pageHeight="1100" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="t-1" value="&lt;b&gt;Producer: upload and registration&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=20;fontColor=#1a1a1a;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="1200" height="30" as="geometry"/></mxCell><mxCell id="t-2" value="A row never points at a missing or corrupt file: the articles row is written only after S3 has the object and its size and SHA-256 match." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#555555;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="20" y="40" width="1400" height="24" as="geometry"/><