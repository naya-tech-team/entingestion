meta {
  name: Redrive by error code
  type: http
  seq: 5
}

post {
  url: {{ingestionUrl}}/v1/dlq/redrive
  body: json
  auth: inherit
}

body:json {
  {
    "error_code": "E_UNREADABLE",
    "max": 100
  }
}

script:pre-request {
  // Starts real work. Folder and collection runs skip it unless the environment sets
  // allowOperations: true; sending it on its own always runs it.
  if (bru.runner && bru.getEnvVar("allowOperations") !== "true") {
    bru.runner.skipRequest();
  }
}

tests {
  test("202", () => {
    expect(res.status).to.equal(202);
  });
}

docs {
  Re-runs failed articles with this error_code (after the fix), resuming at the step where the staged output is intact (UC5).
}
