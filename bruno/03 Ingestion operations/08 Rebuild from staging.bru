meta {
  name: Rebuild from staging
  type: http
  seq: 8
}

post {
  url: {{ingestionUrl}}/v1/reindex
  body: json
  auth: inherit
}

body:json {
  {
    "target_table": "{{liveTable}}",
    "from_stage": "INDEX"
  }
}

script:pre-request {
  // Starts real work. Folder and collection runs skip it unless the environment sets
  // allowOperations: true; sending it on its own always runs it.
  if (bru.runner && bru.getEnvVar("allowOperations") !== "true") {
    bru.runner.skipRequest();
  }
}

tests {
  test("202", () => {
    expect(res.status).to.equal(202);
  });
}

docs {
  UC10: reloads staged vectors into the table; no Bedrock calls.
}
