meta {
  name: Roll back live table
  type: http
  seq: 10
}

post {
  url: {{ingestionUrl}}/v1/tables/active
  body: json
  auth: inherit
}

body:json {
  {
    "table": "{{liveTable}}",
    "force": true
  }
}

script:pre-request {
  // Starts real work. Folder and collection runs skip it unless the environment sets
  // allowOperations: true; sending it on its own always runs it.
  if (bru.runner && bru.getEnvVar("allowOperations") !== "true") {
    bru.runner.skipRequest();
  }
}

tests {
  test("200", () => {
    expect(res.status).to.equal(200);
  });
}

docs {
  Switches `chunks_active` back to `liveTable`, the original table (it was written all along, so nothing is missing).
}
