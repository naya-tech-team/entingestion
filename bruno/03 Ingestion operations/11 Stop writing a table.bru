meta {
  name: Stop writing a table
  type: http
  seq: 11
}

delete {
  url: {{ingestionUrl}}/v1/tables/writes/{{newTable}}
  body: none
  auth: inherit
}

script:pre-request {
  // Starts real work. Folder and collection runs skip it unless the environment sets
  // allowOperations: true; sending it on its own always runs it.
  if (bru.runner && bru.getEnvVar("allowOperations") !== "true") {
    bru.runner.skipRequest();
  }
}

tests {
  test("200", () => {
    expect(res.status).to.equal(200);
  });
}

docs {
  Retires a table from the write set (after switching away from it, or to cancel a model change). The live table can't be retired (409).
}
