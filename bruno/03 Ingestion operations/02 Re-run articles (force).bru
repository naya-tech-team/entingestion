meta {
  name: Re-run articles (force)
  type: http
  seq: 2
}

post {
  url: {{ingestionUrl}}/v1/ingest
  body: json
  auth: inherit
}

body:json {
  {
    "article_ids": ["{{articleId}}"],
    "force": true
  }
}

script:pre-request {
  // Starts real work. Folder and collection runs skip it unless the environment sets
  // allowOperations: true; sending it on its own always runs it.
  if (bru.runner && bru.getEnvVar("allowOperations") !== "true") {
    bru.runner.skipRequest();
  }
}

tests {
  test("202", () => {
    expect(res.status).to.equal(202);
  });
}

docs {
  Re-runs from scratch (or from `from_stage`, e.g. "CHUNK"), ignoring the unchanged check.
}
