vars {
  producerUrl: {{process.env.PRODUCER_URL}}
  ingestionUrl: {{process.env.INGESTION_URL}}
  awsRegion: {{process.env.AWS_REGION}}
  awsProfile: {{process.env.AWS_PROFILE}}
  source: {{process.env.BRUNO_SOURCE}}
  tenantId: {{process.env.BRUNO_TENANT}}
  liveTable: {{process.env.LIVE_TABLE}}
  newTable: {{process.env.NEW_TABLE}}
  allowOperations: false
}
