meta {
  name: UC9 Reindex dry run
  type: http
  seq: 2
}

post {
  url: {{ingestionUrl}}/v1/reindex
  body: json
  auth: inherit
}

body:json {
  {
    "target_table": "chunks_compact",
    "from_stage": "EMBED",
    "dry_run": true
  }
}

tests {
  test("counts the articles", () => {
    expect(res.status).to.equal(200);
    expect(res.body.dry_run).to.equal(true);
    expect(res.body.count).to.be.a("number");
  });
}
