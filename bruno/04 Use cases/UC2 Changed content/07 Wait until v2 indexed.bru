meta {
  name: UC2 Wait until v2 indexed
  type: http
  seq: 7
}

get {
  url: {{ingestionUrl}}/v1/articles/{{articleId}}/status
  body: none
  auth: inherit
}

script:post-response {
  // Polls when run from the collection runner or bru run: repeats this request every
  // 5 s until version 2 is INDEXED, up to 48 times.
  const key = "poll_" + req.getName().replace(/[^A-Za-z0-9_.-]/g, "_");
  const count = (bru.getVar(key) || 0) + 1;
  const done = res.status === 200 && res.body?.latest?.doc_version === 2 && ["INDEXED", "FAILED_PERMANENT"].includes(res.body?.latest?.status);
  if (!done && count < 48 && bru.runner) {
    bru.setVar(key, count);
    bru.setVar("pollPending", true); // the tests wait for the final poll
    await bru.sleep(5000);
    bru.runner.setNextRequest(req.getName());
  } else {
    bru.setVar(key, 0);
    bru.setVar("pollPending", false);
  }
}

tests {
  if (!bru.getVar("pollPending")) {
    test("same article, version 2", () => {
      expect(res.body?.latest?.status).to.equal("INDEXED");
      expect(res.body.latest.doc_version).to.equal(2);
      expect(res.body.runs[0].claim).to.equal("CHANGED");
    });
    test("embedding cache was used", () => {
      const embed = res.body.steps.find(s => s.step === "EMBED");
      expect(embed.metrics.cache_hits).to.be.above(0);
    });
  }
}
