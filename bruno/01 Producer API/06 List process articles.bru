meta {
  name: List process articles
  type: http
  seq: 6
}

get {
  url: {{producerUrl}}/v1/processes/{{processId}}/articles?limit=100
  body: none
  auth: inherit
}

params:query {
  limit: 100
}

tests {
  test("200 with items", () => {
    expect(res.status).to.equal(200);
    expect(res.body.items).to.be.an("array");
  });
}

docs {
  Paginated with `limit` (1-500) and `next_token`.
}
