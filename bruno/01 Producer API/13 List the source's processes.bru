meta {
  name: List the source's processes
  type: http
  seq: 13
}

get {
  url: {{producerUrl}}/v1/processes?source={{source}}&limit=10
  body: none
  auth: inherit
}

params:query {
  source: {{source}}
  limit: 10
}

tests {
  test("200, newest first", () => {
    expect(res.status).to.equal(200);
    expect(res.body.items).to.be.an("array");
  });
}

docs {
  A source's processes, newest first, for its readers and writers; paginated with `next_token`.
}
