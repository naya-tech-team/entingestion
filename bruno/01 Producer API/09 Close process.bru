meta {
  name: Close process
  type: http
  seq: 9
}

post {
  url: {{producerUrl}}/v1/processes/{{processId}}/close
  body: json
  auth: inherit
}

body:json {
  {}
}

tests {
  test("CLOSED", () => {
    expect(res.status).to.equal(200);
    expect(res.body.status).to.equal("CLOSED");
  });
}

docs {
  `expected_count` defaults to the tickets issued so far. Closing again with the same count returns the same process (200).
}
