meta {
  name: Retry create (same Idempotency-Key)
  type: http
  seq: 11
}

post {
  url: {{producerUrl}}/v1/processes
  body: json
  auth: inherit
}

headers {
  Idempotency-Key: {{runTag}}-create
}

body:json {
  {
    "name": "Bruno {{runTag}}",
    "source": "{{source}}",
    "metadata": {"origin": "bruno"}
  }
}

tests {
  test("the first request's process, not a new one", () => {
    expect(res.status).to.equal(201);
    expect(res.body.process_id).to.equal(bru.getVar("processId"));
  });
}

docs {
  A client retrying after a lost response gets the first answer. The same key with a different body is 422.
}
